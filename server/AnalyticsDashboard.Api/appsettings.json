{
  "ConnectionStrings": {
    "AnalyticsDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
